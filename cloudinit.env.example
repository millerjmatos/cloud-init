# Copie para cloudinit.env e ajuste. O arquivo cloudinit.env nao e versionado.
#   cp cloudinit.env.example cloudinit.env && chmod 600 cloudinit.env

# Usuario padrao criado pelo cloud-init
CI_USER=seu-usuario

# Chave(s) publica(s) SSH injetadas na VM (um arquivo, uma chave por linha)
CI_SSHKEYS=/root/.ssh/id_ed25519.pub

# Opcional: senha para console/serial. Deixe vazio para acesso apenas por chave.
# Prefira um hash em vez de texto claro: openssl passwd -6
CI_PASSWORD=
